# ============================================================
# CRYVEX Node/Express Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ------------------------------------------------------------
# DATABASE (PostgreSQL - Main App DB)
# ------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
# For local PostgreSQL: replace user/pass/dbname as needed
DB_HOST=localhost
DB_PORT=5433
DB_NAME=cryvex_db
DB_USER=postgres
DB_PASSWORD=saibi

# ------------------------------------------------------------
# AIRFLOW DB (used for Merkle proof verification)
# This is the same PostgreSQL where Airflow stores its metadata
# and where your merkle_audit table lives
# ------------------------------------------------------------
AIRFLOW_DB_HOST=localhost
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=postgres
AIRFLOW_DB_USER=postgres
AIRFLOW_DB_PASSWORD=postgres

# ------------------------------------------------------------
# JWT Auth
# ------------------------------------------------------------
# Generate a strong random secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=302fbe860c293fba1bda13e739a1eae0c2d1feb6411664ad8599100f86d91f6c6dbd61157723133b293b268a7483700fbff6bd108e18c5565c395671906a14de
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------
# App Settings
# ------------------------------------------------------------
APP_NAME=CRYVEX
DEBUG=true
PORT=8000

# ------------------------------------------------------------
# Airflow REST API (for triggering DAGs)
# ------------------------------------------------------------
# Airflow 3.x uses /api/v2, Airflow 2.x uses /api/v1
# Leave USERNAME/PASSWORD empty if your Airflow has no auth
AIRFLOW_API_URL=http://localhost:8080/api/v2
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# ------------------------------------------------------------
# Blockchain (Ganache / any EVM node)
# ------------------------------------------------------------
# Local Ganache default: http://127.0.0.1:7545  or  http://127.0.0.1:8545
BLOCKCHAIN_PROVIDER_URL=http://localhost:8545
# Deployed smart contract address (from Truffle/Hardhat migrate output)
BLOCKCHAIN_CONTRACT_ADDRESS=
# Private key of the account used to write to blockchain (from Ganache accounts list)
BLOCKCHAIN_PRIVATE_KEY=

# ------------------------------------------------------------
# Target DB (ETL output database - where pipeline writes data)
# ------------------------------------------------------------
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_NAME=cryvex_target
TARGET_DB_USER=postgres
TARGET_DB_PASSWORD=postgres
