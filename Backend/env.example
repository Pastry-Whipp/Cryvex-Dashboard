# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryvex_db

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
APP_NAME=CRYVEX
DEBUG=True

# Airflow Configuration (for pipeline execution)
# AIRFLOW_API_URL is required to enable pipeline execution from the dashboard
# Use /api/v2 for Airflow 3.x, /api/v1 for Airflow 2.x
# Username and password are optional - leave empty if your Airflow has no authentication
AIRFLOW_API_URL=http://localhost:8080/api/v2
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
